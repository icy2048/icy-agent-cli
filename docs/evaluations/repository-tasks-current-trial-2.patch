diff --git a/tests/session-filters.test.ts b/tests/session-filters.test.ts
new file mode 100644
index 0000000..092dffd
--- /dev/null
+++ b/tests/session-filters.test.ts
@@ -0,0 +1,36 @@
+import { mkdtemp, mkdir, writeFile, readFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listSessions } from '../src/sessions/list.js';
+import { main } from '../src/cli.js';
+
+const snapshot = (id: string, cwd: string, status?: string) => ({ version: 2, id, cwd, provider: 'responses', model: 'test', baseUrl: 'https://example.test/v1', updatedAt: '2024-01-01T00:00:00.000Z', messages: [{ role: 'user', content: 'goal' }], runs: [], ...(status ? { task: { id: 'task', goal: 'goal', status, remaining: [], completed: [], mutationRevision: 0, verificationChecks: [], verificationRecords: [] } } : {}) });
+
+async function fixture() {
+  const home = await mkdtemp(path.join(tmpdir(), 'icy-session-filter-'));
+  await mkdir(path.join(home, 'sessions'), { recursive: true });
+  for (const [id, data] of [['one', snapshot('one', '/tmp/work', 'answered')], ['two', snapshot('two', '/tmp/other', 'answered')], ['legacy', snapshot('legacy', '/tmp/work')]] as const) {
+    await mkdir(path.join(home, 'sessions', id));
+    await writeFile(path.join(home, 'sessions', id, 'session.json'), JSON.stringify(data));
+  }
+  await mkdir(path.join(home, 'sessions', 'broken'));
+  await writeFile(path.join(home, 'sessions', 'broken', 'session.json'), '{bad');
+  return home;
+}
+
+test('combines cwd and status, includes legacy, and excludes bad snapshots when filtered', async () => {
+  const home = await fixture();
+  assert.deepEqual((await listSessions(home, { cwd: '/tmp/work', status: 'answered' })).map(s => s.id), ['one']);
+  assert.deepEqual((await listSessions(home, { status: 'legacy' })).map(s => s.id), ['legacy']);
+  assert.ok((await listSessions(home)).find(s => s.id === 'broken')?.error);
+  assert.equal((await listSessions(home, { cwd: '/tmp/work' })).find(s => s.id === 'broken'), undefined);
+});
+
+test('rejects unknown statuses without touching snapshots', async () => {
+  const home = await fixture();
+  const before = await readFile(path.join(home, 'sessions', 'one', 'session.json'), 'utf8');
+  await assert.rejects(listSessions(home, { status: 'nope' }));
+  assert.equal(await readFile(path.join(home, 'sessions', 'one', 'session.json'), 'utf8'), before);
+});
