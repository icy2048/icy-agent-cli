diff --git a/tests/session-filters.test.ts b/tests/session-filters.test.ts
new file mode 100644
index 0000000..7af5bf9
--- /dev/null
+++ b/tests/session-filters.test.ts
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, rm, mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { tmpdir } from 'node:os';
+import { SessionStore } from '../src/sessions/store.js';
+import { listSessions } from '../src/sessions/list.js';
+
+test('session filters combine, support legacy, omit corrupt matches, and are read-only', async () => {
+  const home = await mkdtemp(path.join(tmpdir(), 'icy-filters-')); const stores: SessionStore[] = [];
+  try {
+    for (const [cwd, status] of [[home, 'answered'], [path.join(home, 'other'), 'answered'], [home, 'failed']] as const) {
+      const s = await SessionStore.create(home, { cwd, model: 'fixture', provider: 'responses', baseUrl: 'https://example.test' });
+      s.data.task = { goal: status, status } as typeof s.data.task; s.data.messages.push({ role: 'user', content: status }); await s.save(); stores.push(s);
+    }
+    const before = await readFile(path.join(stores[0].dir, 'session.json'), 'utf8');
+    const legacy = await SessionStore.create(home, { cwd: home, model: 'fixture', provider: 'responses', baseUrl: 'https://example.test' }); await legacy.save(); stores.push(legacy);
+    await mkdir(path.join(home, 'sessions', 'bad')); await writeFile(path.join(home, 'sessions', 'bad', 'session.json'), '{');
+    assert.deepEqual((await listSessions(home, { cwd: home, status: 'answered' })).map(x => x.id), [stores[0].data.id]);
+    assert.deepEqual((await listSessions(home, { cwd: home, status: 'legacy' })).map(x => x.id), [legacy.data.id]);
+    assert.throws(() => listSessions(home, { status: 'nope' }), /未知会话状态/);
+    assert.equal((await listSessions(home)).some(x => x.id === 'bad' && x.error), true);
+    assert.equal((await listSessions(home, { cwd: home })).some(x => x.id === 'bad'), false);
+    assert.equal(await readFile(path.join(stores[0].dir, 'session.json'), 'utf8'), before);
+  } finally { for (const s of stores) await s.close(); await rm(home, { recursive: true, force: true }); }
+});
+
+test('status is wired only to sessions by the CLI contract', async () => {
+  const cli = await readFile(new URL('../src/cli.tsx', import.meta.url), 'utf8');
+  assert.match(cli, /status: \{ type: 'string' \}/);
+  assert.match(cli, /--status 只能用于 sessions/);
+  assert.match(cli, /listSessions\(config\.home, \{ cwd: values\.cwd, status: values\.status \}\)/);
+});
