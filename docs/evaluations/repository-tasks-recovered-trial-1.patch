diff --git a/tests/session-filters.test.ts b/tests/session-filters.test.ts
new file mode 100644
index 0000000..f595b31
--- /dev/null
+++ b/tests/session-filters.test.ts
@@ -0,0 +1,28 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { listSessions } from '../src/sessions/list.js';
+
+const base = (id: string, cwd: string) => ({ version: 1, id, cwd, provider: 'responses', model: 'm', baseUrl: 'https://example.test', messages: [], updatedAt: '2024-01-01T00:00:00Z' });
+async function fixture() {
+  const home = await mkdtemp(path.join(tmpdir(), 'icy-session-filter-'));
+  const a = path.join(home, 'a'), b = path.join(home, 'b');
+  await Promise.all([mkdir(path.join(home, 'sessions', 'legacy')), mkdir(path.join(home, 'sessions', 'bad')), mkdir(a), mkdir(b)]);
+  await writeFile(path.join(home, 'sessions', 'legacy', 'session.json'), JSON.stringify(base('legacy', a)));
+  await writeFile(path.join(home, 'sessions', 'bad', 'session.json'), '{ broken');
+  return { home, a, b };
+}
+
+test('session filters combine cwd and legacy, reject unknown status, and skip bad snapshots only when filtered', async () => {
+  const f = await fixture();
+  try {
+    const all = await listSessions(f.home);
+    assert.equal(all.length, 2); assert.ok(all.some(s => s.error));
+    assert.deepEqual((await listSessions(f.home, { cwd: f.a, status: 'legacy' })).map(s => s.id), ['legacy']);
+    assert.deepEqual(await listSessions(f.home, { cwd: f.b }), []);
+    await assert.rejects(() => listSessions(f.home, { status: 'nope' }), /未知会话状态/);
+    assert.deepEqual((await readFile(path.join(f.home, 'sessions', 'legacy', 'session.json'), 'utf8')), JSON.stringify(base('legacy', f.a)));
+  } finally { await rm(f.home, { recursive: true, force: true }); }
+});
