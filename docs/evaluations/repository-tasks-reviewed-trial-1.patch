diff --git a/tests/session-filters.test.ts b/tests/session-filters.test.ts
new file mode 100644
index 0000000..f704861
--- /dev/null
+++ b/tests/session-filters.test.ts
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, readFile, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import { listSessions } from '../src/sessions/list.js';
+import { main } from '../src/cli.js';
+
+const stamp = '2025-01-01T00:00:00.000Z';
+function snapshot(id: string, cwd: string, status?: string) {
+  return { version: 2, id, cwd, provider: 'responses', model: 'test', baseUrl: 'https://example.test/v1', messages: [{ role: 'user', content: id, calls: [] }], updatedAt: stamp, runs: [], ...(status ? { task: { id: `task-${id}`, goal: id, status, remaining: [], completed: [], mutationRevision: 0, verificationChecks: [], verificationRecords: [] } } : {}) };
+}
+async function homeWith(items: Record<string, unknown>) {
+  const home = await mkdtemp(path.join(os.tmpdir(), 'icy-session-filter-'));
+  await mkdir(path.join(home, 'sessions'));
+  for (const [id, value] of Object.entries(items)) { await mkdir(path.join(home, 'sessions', id)); await writeFile(path.join(home, 'sessions', id, 'session.json'), JSON.stringify(value)); }
+  return home;
+}
+
+test('combines cwd and status filters and recognizes legacy', async () => {
+  const cwd = path.resolve('filter-workspace');
+  const home = await homeWith({ answered: snapshot('answered', cwd, 'answered'), other: snapshot('other', cwd, 'failed'), legacy: { version: 1, id: 'legacy', cwd, provider: 'responses', model: 'test', baseUrl: 'https://example.test/v1', messages: [], updatedAt: stamp } });
+  assert.deepEqual((await listSessions(home, { cwd: './filter-workspace', status: 'answered' })).map(s => s.id), ['answered']);
+  assert.deepEqual((await listSessions(home, { status: 'legacy' })).map(s => s.id), ['legacy']);
+});
+
+test('rejects unknown status and omits uncertain corrupt snapshots only when filtering', async () => {
+  const cwd = path.resolve('filter-workspace');
+  const home = await homeWith({ good: snapshot('good', cwd, 'answered'), broken: { nope: true } });
+  await assert.rejects(() => listSessions(home, { status: 'bogus' }), /未知会话状态/);
+  assert.equal((await listSessions(home)).some(s => s.id === 'broken' && 'error' in s), true);
+  assert.equal((await listSessions(home, { status: 'answered' })).some(s => s.id === 'broken'), false);
+});
+
+test('listing has no side effects and CLI applies both filters', async () => {
+  const cwd = path.resolve('filter-workspace');
+  await mkdir(cwd, { recursive: true });
+  const home = await homeWith({ yes: snapshot('yes', cwd, 'answered'), no: snapshot('no', cwd, 'failed') });
+  const before = await readFile(path.join(home, 'sessions', 'yes', 'session.json'), 'utf8');
+  const oldHome = process.env.ICY_HOME; process.env.ICY_HOME = home;
+  const chunks: string[] = []; const oldWrite = process.stdout.write; process.stdout.write = ((chunk: string) => { chunks.push(chunk); return true; }) as typeof process.stdout.write;
+  try { await main(['sessions', '--json', '--status', 'answered', '--cwd', './filter-workspace']); } finally { process.stdout.write = oldWrite; if (oldHome === undefined) delete process.env.ICY_HOME; else process.env.ICY_HOME = oldHome; }
+  assert.equal(chunks.join('').includes('"id":"yes"'), true); assert.equal(chunks.join('').includes('"id":"no"'), false);
+});
+
+test('sessions treats a nonexistent cwd as an empty filter and rejects status elsewhere before config work', async () => {
+  const home = await homeWith({ answer: snapshot('answer', path.resolve('somewhere'), 'answered') });
+  const oldHome = process.env.ICY_HOME; process.env.ICY_HOME = home;
+  const chunks: string[] = []; const oldWrite = process.stdout.write; process.stdout.write = ((chunk: string) => { chunks.push(chunk); return true; }) as typeof process.stdout.write;
+  try {
+    await main(['sessions', '--json', '--status', 'answered', '--cwd', path.join(home, 'does-not-exist')]);
+  } finally { process.stdout.write = oldWrite; if (oldHome === undefined) delete process.env.ICY_HOME; else process.env.ICY_HOME = oldHome; }
+  assert.equal(chunks.join(''), '');
+  await assert.rejects(() => main(['config', 'init', '--status', 'answered']), /--status 只能用于 sessions/);
+});
